{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attendance Collector Configuration",
  "description": "Schema de validación para collector.yaml",
  "type": "object",
  "required": ["platform", "devices"],
  "properties": {
    "platform": {
      "type": "object",
      "required": ["url", "api_key", "tenant_id"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "api_key": {"type": "string"},
        "tenant_id": {"type": "string"},
        "timeout": {"type": "integer", "minimum": 1, "default": 30},
        "retry_attempts": {"type": "integer", "minimum": 0, "default": 3}
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ip"],
        "properties": {
          "ip": {
            "type": "string",
            "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
          },
          "port": {"type": "integer", "default": 4370, "minimum": 1, "maximum": 65535},
          "timeout": {"type": "integer", "default": 5, "minimum": 1},
          "password": {"type": "integer", "default": 0},
          "name": {"type": "string"},
          "enabled": {"type": "boolean", "default": true}
        }
      }
    },
    "poll_interval_seconds": {
      "type": "integer",
      "default": 300,
      "minimum": 60,
      "maximum": 3600
    },
    "sync_interval_seconds": {
      "type": "integer",
      "default": 60,
      "minimum": 10,
      "maximum": 600
    },
    "buffer": {
      "type": "object",
      "properties": {
        "max_records": {"type": "integer", "default": 10000, "minimum": 100},
        "retention_days": {"type": "integer", "default": 730, "minimum": 1}
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
          "default": "INFO"
        },
        "max_size_mb": {"type": "integer", "default": 10, "minimum": 1},
        "backup_count": {"type": "integer", "default": 5, "minimum": 1}
      }
    }
  }
}
