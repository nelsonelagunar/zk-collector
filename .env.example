# ZK-Collector Docker Environment Variables
# Copy this file to .env and fill in your values
# docker-compose up -d will use this automatically

# ─── Required ────────────────────────────────────────────────────────────────

# Admin password for web dashboard login (default: admin / this password)
ZK_ADMIN_PASSWORD=changeme

# ─── Cloud Sync (Optional) ──────────────────────────────────────────────────

# Platform URL for cloud sync (leave empty to disable sync)
# Example: ZK_SYNC_URL=https://api.my-platform.com
ZK_SYNC_URL=

# API token for cloud platform authentication (leave empty to disable sync)
# Example: ZK_SYNC_TOKEN=eyJhbGciOiJIUzI1NiIs...
ZK_SYNC_TOKEN=

# ─── Encryption (Required for production) ───────────────────────────────────

# Fernet encryption key for sensitive config values (platform API key, device passwords)
# Generate with: python -m src.security.encryption generate-key
# Example: ENCRYPTION_KEY=gAAAAABl8...
ENCRYPTION_KEY=

# ─── Advanced / Optional ────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: text or json
LOG_FORMAT=text

# WebGUI secret key for sessions (auto-generated if not set)
WEBGUI_SECRET_KEY=

# Custom data directory (default: /app/data)
# DATA_DIR=/app/data